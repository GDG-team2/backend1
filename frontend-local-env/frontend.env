# 오하꼼 프론트엔드(GDG-team2/frontend) 로컬 테스트용 환경변수
# 이 파일을 프론트엔드 프로젝트 루트에 ".env" 이름으로 복사하세요.

# 실제 백엔드(Render) 서버에 연결
EXPO_PUBLIC_API_BASE_URL=https://ohakkom-backend.onrender.com/api/v1
EXPO_PUBLIC_USE_MSW=false

# 임시 약관 주소 (https로 시작해야 회원가입 버튼이 활성화됨)
# 로컬 테스트 전용입니다. 실제 배포 시에는 진짜 약관 원문 주소로 교체하세요.
EXPO_PUBLIC_SERVICE_TERMS_URL=https://example.com/terms/service
EXPO_PUBLIC_PRIVACY_TERMS_URL=https://example.com/terms/privacy
EXPO_PUBLIC_LOCATION_TERMS_URL=https://example.com/terms/location
